# Local development only. Keep real credentials in an untracked .env file.
AUTH_DISABLED=1
DATABASE_PATH=backend/tidyboard.sqlite3
FRONTEND_ORIGIN=http://localhost:4173
API_BASE_URL=http://localhost:8000

# OAuth is deferred for the hosted release; leave these unset locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
